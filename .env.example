APP_NAME="Research & Extension Monitoring System"
APP_URL=https://your-app.vercel.app
APP_TIMEZONE=Asia/Manila

# Neon Postgres (recommended on Vercel — connect via Storage → Neon or neon.tech → Integrations → Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Or individual Postgres variables (also set by Neon/Vercel integration):
# PGHOST=ep-xxxx-pooler.region.aws.neon.tech
# PGPORT=5432
# PGDATABASE=neondb
# PGUSER=USER
# PGPASSWORD=PASSWORD

# Local XAMPP MySQL (omit DATABASE_URL to use these defaults):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=ride_ims
# DB_USER=root
# DB_PASS=
