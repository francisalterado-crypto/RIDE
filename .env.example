# Reference list of the settings RIDE Hub reads from the environment.
# The application does not load this file: set real environment variables on the server, for example with
# SetEnv in the Apache virtual host. Never commit real values.

# Base URL of the application, without a trailing slash. Optional: defaults to https://ride.wpu.edu.ph, or
# http://localhost/RIDE when opened on localhost.
APP_URL=https://ride.wpu.edu.ph
APP_NAME="RIDE Hub - Information Management System for RIDE"
APP_TIMEZONE=Asia/Manila

# Session lifetime in seconds.
SESSION_LIFETIME=7200

# MySQL / MariaDB connection.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ride_ims
DB_USER=ride_app
DB_PASS=change-me

# Optional TLS to the database server.
# DB_SSL=true
# DB_SSL_CA=/path/to/ca.pem
# DB_SSL_VERIFY=true

# Alternatively, one connection URL instead of the DB_* values:
# DATABASE_URL=mysql://ride_app:change-me@127.0.0.1:3306/ride_ims
